inet 0.0.0.0 255.255.255.255 NONE mtu 1492 \
        pppoedev vlan10 authproto pap \
        authname '' authkey '' \
        group egress up
dest 0.0.0.1

# Default route set at Priority 4 so it takes immediate precedence
!/sbin/route add -priority 4 default -ifp pppoe0 0.0.0.1

# Pin health-check targets strictly to pppoe0
!/sbin/route add 1.1.1.1 -ifp pppoe0 0.0.0.1
!/sbin/route add 8.8.8.8 -ifp pppoe0 0.0.0.1


# EOF
